{
  "manifest_version": 3,
  "name": "Goriva.online – Цени на горивата",
  "version": "1.0.0",
  "description": "Актуални цени на горивата по градове в България от goriva.online.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Цени на горивата",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://eaqvhxfvozhzatrnbkvx.supabase.co/*"
  ]
}
